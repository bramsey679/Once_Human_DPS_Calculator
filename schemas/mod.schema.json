{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Once Human mod record",
  "type": "object",
  "required": [
    "id",
    "name",
    "tier",
    "slot",
    "effect_text",
    "source_refs"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "tier": {
      "type": "string"
    },
    "slot": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "effect_text": {
      "type": "string"
    },
    "stats": {
      "type": "object"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
